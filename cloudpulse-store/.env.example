# Copy to .env and adjust:  cp .env.example .env
# Never commit the real .env file.

# ---- Application ----
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# Seeds demo products only when the products table is empty.
SEED_ON_STARTUP=true

# ---- Public HTTP port of the Nginx/frontend container ----
# Local Mac / simple EC2:     HTTP_BIND=0.0.0.0   HTTP_PORT=80
# EC2 behind host HTTPS:      HTTP_BIND=127.0.0.1 HTTP_PORT=8080
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# ---- Optional monitoring profile (docker compose --profile monitoring up -d) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
