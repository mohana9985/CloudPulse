# Copy to .env and adjust:  cp .env.example .env
# Never commit the real .env file.

# ---- Application ----
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# Seeds demo products only when the products table is empty.
SEED_ON_STARTUP=true

# ---- Public HTTP port of the Nginx/frontend container ----
# Local Mac / simple EC2:     HTTP_BIND=0.0.0.0   HTTP_PORT=80
# EC2 behind host HTTPS:      HTTP_BIND=127.0.0.1 HTTP_PORT=8080
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# ---- Host ports on THIS machine (change here if a port is already taken) ----
# Inside Docker the containers always use 8090/8095/9090/3000; these are the host side only.
GATEWAY_PORT=8090
LOADGEN_PORT=8095
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Optional monitoring profile (docker compose --profile monitoring up -d) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Failure demo endpoint on the backends (dashboard "Real crash"); set false to disable.
ENABLE_CHAOS=true

# ---- Monitoring on by default (same as passing --monitoring to deploy.sh) ----
# COMPOSE_PROFILES=monitoring

# ---- Scheduling gateway ----
# round_robin | weighted_round_robin | least_loaded | sjf | fcfs
ALGORITHM=least_loaded
# CPU quota per backend replica (heterogeneous servers)
B1_CPUS=0.75
B2_CPUS=0.45
B3_CPUS=0.30

# ---- Two-EC2 setup (docs/AWS_TWO_EC2.md): uncomment ALL five lines on the STORE instance ----
# The dashboard instance then reaches the gateway, loadgen and Prometheus over the private network.
# Security group: allow 8090/8095/9090 ONLY from the dashboard instance's security group.
# COMPOSE_FILE=compose.yaml:compose.two-host.yaml
# SCHEDULER_HOST=<private IPv4 of the dashboard EC2, e.g. 172.31.10.20>
# GATEWAY_BIND=0.0.0.0
# LOADGEN_BIND=0.0.0.0
# PROMETHEUS_BIND=0.0.0.0

# ---- Optional: open Grafana in the browser WITHOUT a tunnel (no terminal during a demo) ----
# On the STORE EC2 only. Then browse http://<EC2-1-public-IP>:3001 (login = GRAFANA_ADMIN_*).
# Security group: add inbound TCP 3001 from "My IP" ONLY (never 0.0.0.0/0).
# GRAFANA_BIND=0.0.0.0
# GRAFANA_PORT=3001
