# Python virtual environments
.venv/
venv/
env/

# Environment secrets: IPs and settings live only in .env (template: .env.example)
.env
.env.*
*.env
!.env.example

# Keys
*.pem
*.key

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Python tooling
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# IDE and editor files
.idea/
.vscode/

# Temporary files
*.log
*.tmp

# Experiment outputs:
# Ignore generated experiments by default.
results/*
charts/*

# Keep placeholder files so the empty directories exist.
!results/README.md
!charts/README.md

# Preserve the verified Stage 4 experiment results.
!results/stage4-grid/
!results/stage4-grid/**

# Preserve the Stage 4 comparison charts.
!charts/stage4-grid/
!charts/stage4-grid/**

# Preserve recorded live (REAL execution) experiments and their charts.
!results/live-*/
!results/live-*/**
!results/live-*.log
!charts/live-*/
!charts/live-*/**
