# Copy to .env and adjust:  cp .env.example .env
# Never commit the real .env file (it is in .gitignore).

# ---- Scheduler ----
# round_robin | weighted_round_robin | least_loaded | sjf | fcfs
ALGORITHM=least_loaded
HEARTBEAT_INTERVAL=2
# CPU quota per worker (heterogeneous machines)
W1_CPUS=0.75
W2_CPUS=0.45
W3_CPUS=0.30
# Failure demo endpoints on the workers; set false to disable.
ENABLE_CHAOS=true

# ---- Host ports on THIS machine (change here if a port is already taken) ----
# Containers always use 8100 / 8501 inside Docker; these are the host side only.
# Keep COORDINATOR_PORT=8100 on the dashboard EC2: the store Prometheus scrapes :8100.
# From your computer the AWS coordinator is reached on localhost:8101 (store .env:
# AWS_COORDINATOR_LOCAL_PORT, opened by cloudpulse-store/deployment/aws/tunnel.sh).
COORDINATOR_PORT=8100
DASHBOARD_PORT=8501

# ---- Dashboard ----
# Where the browser opens Grafana. Leave unset to use the defaults:
#   local Docker  -> http://localhost:3000
#   two-EC2 (AWS) -> http://localhost:3001  (SSH tunnel: -L 3001:127.0.0.1:3000 to the store EC2)
#   two-EC2, no tunnel (store .env GRAFANA_BIND=0.0.0.0 + GRAFANA_PORT=3001):
#                    GRAFANA_PUBLIC_URL=http://<EC2-1-public-IP>:3001
# GRAFANA_PUBLIC_URL=http://localhost:3000
# Must match B1/B2/B3_CPUS in the store's .env (only used for the CPU % charts).
B1_CPUS=0.75
B2_CPUS=0.45
B3_CPUS=0.30

# ---- Two-EC2 setup (../cloudpulse-store/docs/AWS_TWO_EC2.md): uncomment ALL four lines on the
# DASHBOARD instance. Security group: 8501 from your IP only, 8100 only from the store's SG.
# COMPOSE_FILE=compose.yaml:compose.two-host.yaml
# STORE_HOST=<private IPv4 of the store EC2, e.g. 172.31.10.10>
# DASHBOARD_BIND=0.0.0.0
# COORDINATOR_BIND=0.0.0.0
# Only if you changed GATEWAY_PORT / LOADGEN_PORT / PROMETHEUS_PORT in the store EC2 .env:
# STORE_GATEWAY_PORT=8090
# STORE_LOADGEN_PORT=8095
# STORE_PROMETHEUS_PORT=9090
